{
  "name": "agentmesh-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hibrit çoklu ajan IDE'si için ilk orkestrasyon çekirdeği",
  "scripts": {
    "demo": "tsx src/demo.ts",
    "live": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && node scripts/run-desktop.mjs",
    "desktop:smoke": "npm run desktop:build && node scripts/run-desktop.mjs --smoke-test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
