{
  "name": "agentmesh-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hibrit çoklu ajan IDE'si için ilk orkestrasyon çekirdeği",
  "scripts": {
    "demo": "tsx src/demo.ts",
    "live": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "e2e:codex": "tsx scripts/e2e-codex.ts",
    "typecheck": "tsc --noEmit",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && node scripts/run-desktop.mjs",
    "desktop:smoke": "npm run desktop:build && node scripts/run-desktop.mjs --smoke-test",
    "desktop:smoke:editor": "npm run desktop:build && node scripts/run-desktop.mjs --smoke-test --editor-smoke-test",
    "desktop:smoke:window": "npm run desktop:build && node scripts/run-desktop.mjs --window-smoke-test",
    "desktop:smoke:opencode-tui": "npm run desktop:build && node scripts/run-desktop.mjs --opencode-tui-smoke-test",
    "smoke:opencode": "tsx src/smoke-opencode.ts",
    "desktop:package": "npm run desktop:build && node scripts/package-desktop.mjs",
    "desktop:package:smoke": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.9.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
